// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id    String @id @default(auto()) @map("_id") @db.ObjectId

  name String
  about String
  email String @unique

  palletes PalleteTonal[]
  likes Like[]
  auth Auth?

  createdAt      DateTime @default(now()) // Data que o registro foi criada
  updatedAt      DateTime @updatedAt // Data que o registro foi modificado pela ultima vez

}

model Auth {
  id     String   @id @default(auto()) @map("_id") @db.ObjectId

  userID String   @unique @db.ObjectId
  user   User     @relation(fields: [userID], references: [id])
  hash   String

  failedAttempts Int      @default(0) // Tentativas falhas ao tentar logar
  lockedUntil    DateTime? // Guarda o tempo para tentar logar denovo

  createdAt      DateTime @default(now()) // Data que o registro foi criada
  updatedAt      DateTime @updatedAt // Data que o registro foi modificado pela ultima vez
  passwordChangedAt DateTime @default(now()) // Data que a senha foi modificada pela ultima vez
}

model PalleteTonal {
  id    String @id @default(auto()) @map("_id") @db.ObjectId

  name String
  description String

  // Cores da Paleta
  colors String[]

  // Campos de refencia estrangeiras
  authorID String @db.ObjectId

   // Define as relações onde os campos pegara a referencia do tipo
  author User @relation(fields: [authorID], references: [id])

  likes Like[]
  createdAt      DateTime @default(now()) // Data que o registro foi criada
  updatedAt      DateTime @updatedAt // Data que o registro foi modificado pela ultima vez
}

model Like {
  id    String @id @default(auto()) @map("_id") @db.ObjectId

  // Campos de refencia estrangeiras
  userID String @db.ObjectId
  palleteTonalID String @db.ObjectId

  // Define as relações onde os campos pegara a referencia do tipo
  user User @relation(fields: [userID], references: [id])
  palleteTonal PalleteTonal @relation(fields: [palleteTonalID], references: [id])

  createdAt      DateTime @default(now()) // Data que o registro foi criada

  @@unique([userID,palleteTonalID])
}
